{
  "name": "pixi-release",
  "private": true,
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "description": "Safe release workflow controller for Pixi projects",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "crates",
    "apps/docs"
  ],
  "scripts": {
    "all:build": "bun x turbo run build",
    "all:test": "bun x turbo run test",
    "all:typecheck": "bun x turbo run typecheck",
    "all:lint": "bun x turbo run lint",
    "all:fmt": "bun x turbo run fmt",
    "build": "bun run crates/xtask/scripts/verify-workspace.ts --build",
    "test": "bun test crates/xtask/scripts",
    "typecheck": "bun run crates/xtask/scripts/verify-workspace.ts --typecheck",
    "lint": "bun x biome check .",
    "fmt": "bun x biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "backlog.md": "1.53.0",
    "turbo": "2.11.5"
  }
}
