{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "package.json",
    "bun.lock",
    "pixi.toml",
    "pixi.lock",
    "Cargo.toml",
    "Cargo.lock"
  ],
  "globalEnv": [
    "PIXI_RELEASE_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false
    },
    "fmt": {
      "cache": false
    },
    "//#coverage": {
      "outputs": [],
      "cache": false
    },
    "//#build": {
      "outputs": []
    },
    "//#test": {
      "outputs": []
    },
    "//#typecheck": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "CARGO_HOME"
  ]
}
